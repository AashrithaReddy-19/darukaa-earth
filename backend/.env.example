# Copy to .env and fill in real values for local development. Never commit .env.

# SQLAlchemy connection string for the main application database (Postgres + PostGIS).
DATABASE_URL=postgresql+psycopg2://darukaa:darukaa@localhost:5432/darukaa

# Connection string for a disposable Postgres + PostGIS database used only by pytest.
TEST_DATABASE_URL=postgresql+psycopg2://darukaa:darukaa@localhost:5432/darukaa_test

# JWT signing secret -- generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origin allowed by CORS for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

ENVIRONMENT=development
