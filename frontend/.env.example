# Base URL of the Darukaa.Earth backend API (FastAPI), including the /api/v1 prefix's parent.
# The app appends /api/v1/... itself, so point this at the server root.
VITE_API_BASE_URL=http://localhost:8000

# Mapbox GL JS public access token. Create a free account at https://account.mapbox.com/
# and copy a token starting with "pk.". Never commit a real token.
VITE_MAPBOX_TOKEN=
