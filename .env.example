# =============================================================================
# Darukaa.Earth — root environment reference
# =============================================================================
# This file documents every environment variable used across the stack when
# running via Docker Compose. Copy it to `.env` in the repo root for Compose,
# and also see backend/.env.example and frontend/.env.example for the values
# each service reads when run standalone (outside Docker).
#
# NEVER commit a real .env file or real secrets. This file must only ever
# contain placeholders.
# =============================================================================

# --- PostgreSQL / PostGIS (used by the "db" service in docker-compose.yml) --
POSTGRES_USER=darukaa
POSTGRES_PASSWORD=darukaa_dev_password
POSTGRES_DB=darukaa_earth

# --- Backend (FastAPI) -------------------------------------------------------
# Full SQLAlchemy connection string. Docker Compose builds this automatically
# for the "backend" service from the POSTGRES_* vars above; only needed here
# if you override the backend's own connection string directly.
DATABASE_URL=postgresql+psycopg2://darukaa:darukaa_dev_password@localhost:5432/darukaa_earth

# Secret used to sign JWT access/refresh tokens. Generate a strong random
# value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origin allowed by the backend's CORS policy (the frontend's URL).
FRONTEND_ORIGIN=http://localhost:5173

ENVIRONMENT=development

# --- Frontend (Vite) ----------------------------------------------------------
# Base URL of the backend API SERVER ROOT (no /api/v1 suffix — the frontend
# appends /api/v1/... to this itself).
VITE_API_BASE_URL=http://localhost:8000

# Mapbox GL JS access token. Create a free account at https://account.mapbox.com/
# and generate a token there — never hard-code a real token in source control.
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# --- CI/CD & Deployment secrets (set these in GitHub Actions / hosting
#     provider dashboards — never in a committed .env file) ------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# RENDER_DEPLOY_HOOK_URL=
